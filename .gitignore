# Build outputs. Everything here is regenerated by `nvaddon build`;
# `nvaddon clean` removes them.
*.nvda-addon
*.pot
*.mo
addon/manifest.ini
addon/locale/*/manifest.ini

# Leave the built docs since we are changing to .github/README.md version for landing page
# and want properly rendered HTML, that is Python markdown and mdownx to be available for pages
#addon/doc/style.css
#addon/doc/en/
#addon/doc/*/*.html

# Addon creates settings.json
settings.json

# Python
*.py[co]
__pycache__/
*.egg-info/
.venv/

# Editors and operating systems
.DS_Store
Thumbs.db
*.save
