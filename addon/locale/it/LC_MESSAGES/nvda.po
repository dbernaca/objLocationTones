#. Translators: Summary/title for this add-on, to be shown on installation
#. and in add-on information found in the add-on store.
#: addon.toml:17
msgid "Object Location Tones"
msgstr "Object Location Tones"

#. Translators: Long description to be shown for this add-on
#. in add-on information from the add-on store.
#: addon.toml:21
msgid ""
"Announce location of objects via tones.\n"
"This add-on brings positional audio capabilities to NVDA screen reader."
msgstr ""
"Segnala la posizione degli oggetti mediante toni.\n"
"Questo componente aggiuntivo introduce funzionalità di audio posizionale "
"nel lettore di schermo NVDA."

#. Translators: What's new in this version of the add-on, shown in the add-on
#. store.
#: addon.toml:29
msgid ""
"* NVDA 2026.2 compatibility\n"
"* New feature: Choose location presentation mode (Lets you choose object "
"detection during navigation and position within the object that is "
"announced via tone)\n"
"* New feature: Mouse monitoring reference point that uses navigator "
"object\n"
"* New feature: Enable/disable the mouse monitoring stop message\n"
"* New feature: Enable/disable reporting caret location only at tabs and "
"spaces\n"
"* New feature: Use a gesture to reset MIDI output\n"
"* Added translations for Croatian, Italian and Spanish\n"
"---\n"
"Please read more about each of the new features in readme to understand "
"better how they work.\n"
"---\n"
"* Some more microoptimization in effectiveness\n"
"* Some bug fixes that didn't affect the previous versions of the add-on, "
"but would have in future versions"
msgstr ""
"* Compatibilità con NVDA 2026.2\n"
"* Nuova funzionalità: scelta della modalità di presentazione della "
"posizione (consente di scegliere l'oggetto da rilevare durante la "
"navigazione e il punto al suo interno da segnalare mediante un tono)\n"
"* Nuova funzionalità: punto di riferimento per il monitoraggio del mouse "
"basato sull'oggetto del navigatore\n"
"* Nuova funzionalità: attivazione o disattivazione dell’annuncio della "
"fine automatica del monitoraggio del mouse\n"
"* Nuova funzionalità: attivazione o disattivazione della segnalazione "
"della posizione del cursore di sistema solo in corrispondenza di "
"tabulazioni e spazi\n"
"* Nuova funzionalità: ripristino dell'output MIDI mediante un gesto\n"
"* Aggiunte le traduzioni in croato, italiano e spagnolo\n"
"---\n"
"Per comprendere meglio il funzionamento delle nuove funzionalità, "
"consultare la relativa descrizione nel file README.\n"
"---\n"
"* Ulteriori micro-ottimizzazioni delle prestazioni\n"
"* Correzione di alcuni errori che non incidevano sulle versioni "
"precedenti del componente aggiuntivo, ma che avrebbero causato problemi "
"nelle versioni future"

#. Input gestures dialog category label for objLocTones.
#. A category name in the NVDA settings dialog
#: addon/globalPlugins/objloc/UIStrings.py:24
#: addon/globalPlugins/objloc/UIStrings.py:104
msgid "Positional tones"
msgstr "Toni posizionali"

#. Focused object outline report gesture description in the input gesture
#. dialog
#: addon/globalPlugins/objloc/UIStrings.py:27
msgid "Reports outline of a current object via positional tones"
msgstr "Riproduce il contorno dell'oggetto corrente con toni posizionali"

#. Parent object outline report gesture description in the input gesture dialog
#: addon/globalPlugins/objloc/UIStrings.py:30
msgid "Reports outline of a parent of the current object via positional tones"
msgstr ""
"Riproduce il contorno dell'oggetto padre dell'oggetto corrente con toni "
"posizionali"

#. The toggle mouse location monitoring gesture description in the input
#. gesture dialog
#: addon/globalPlugins/objloc/UIStrings.py:33
msgid ""
"Toggles a mouse cursor position in relation to reference point location "
"reporting via positional tones"
msgstr ""
"Attiva o disattiva la segnalazione con toni posizionali della posizione "
"del puntatore del mouse rispetto al punto di riferimento"

#. Input dialog gesture description for on request of mouse cursor location
#: addon/globalPlugins/objloc/UIStrings.py:36
msgid "Plays a positional tone for a mouse cursor"
msgstr "Riproduce un tono posizionale per il puntatore del mouse"

#. The gesture description for on request object location in the input gesture
#. dialog
#: addon/globalPlugins/objloc/UIStrings.py:39
msgid "Plays a positional tone for a current object"
msgstr "Riproduce un tono posizionale per l'oggetto corrente"

#. The Object Location Tones toggle gesture description in the input gesture
#. dialog
#: addon/globalPlugins/objloc/UIStrings.py:42
msgid ""
"Toggles automatic auditory description of object locations via positional"
" tones"
msgstr ""
"Attiva o disattiva la descrizione acustica automatica della posizione "
"degli oggetti con toni posizionali"

#. The Object Location Tones toggle of caret reporting gesture description in
#. the input gesture dialog
#: addon/globalPlugins/objloc/UIStrings.py:45
msgid "Toggles caret location reporting via positional tones"
msgstr ""
"Attiva o disattiva la segnalazione della posizione del cursore di sistema"
" con toni posizionali"

#. Description for cycling through caret reporting modes in the input gesture
#. dialog
#: addon/globalPlugins/objloc/UIStrings.py:48
msgid "Cycles through caret reporting modes"
msgstr "Passa alla modalità successiva di segnalazione del cursore di sistema"

#. ui.message() when fetching parent object for positional audio and there is
#. no parent to fetch
#: addon/globalPlugins/objloc/UIStrings.py:51
msgid "Parent object not available"
msgstr "Oggetto padre non disponibile"

#. ui.message() in reporting parent outline script
#. The message is dynamic and thus only partially translatable
#. %s will be fetched using NVDA's API, so the content translation will be
#. managed by NVDA
#. %i is a level of the ancestor in the ancestors tree
#. so, only a word/words regarding explaining that number for
#. the NVDA's object description
#. To understand completely, use the parent outline feature by
#. pressing Ctrl+Alt+Shift+Numpad Delete,
#. Complete format is "%s, ancestor %i" where %s and %i are out of gettext for
#. now
#: addon/globalPlugins/objloc/UIStrings.py:62
msgid "ancestor"
msgstr "antenato"

#. ui.message() in all cases when the location of an object, for any reason,
#. cannot be detected
#: addon/globalPlugins/objloc/UIStrings.py:65
msgid "Location unavailable"
msgstr "Posizione non disponibile"

#. ui.message() in mouse monitoring, when triggered, and the mouse cursor
#. is already at the position of the focused object
#: addon/globalPlugins/objloc/UIStrings.py:69
msgid "Mouse already there"
msgstr "Il puntatore del mouse è già in posizione"

#. ui.message() when user cancels the mouse monitoring by triggering the script
#. via gesture
#: addon/globalPlugins/objloc/UIStrings.py:72
msgid "Mouse location monitoring cancelled"
msgstr "Monitoraggio del mouse annullato"

#. ui.message() when the mouse monitoring stops automatically after the mouse
#. is stationary for too long
#: addon/globalPlugins/objloc/UIStrings.py:75
msgid "Mouse location monitoring stopped"
msgstr "Monitoraggio del mouse concluso"

#. ui.message() during the mouse monitoring when the mouse enters the focused
#. object area
#. The object's description will be added at the end of the string
#: addon/globalPlugins/objloc/UIStrings.py:79
msgid "Entering"
msgstr "Ingresso in"

#. ui.message() during the mouse monitoring when the mouse exits the focused
#. object area
#. The object's description will be added at the end of the string
#: addon/globalPlugins/objloc/UIStrings.py:83
msgid "Leaving"
msgstr "Uscita da"

#. ui.message() when during the mouse monitoring the mouse cursor is brought to
#. the denoted location of the focused object
#: addon/globalPlugins/objloc/UIStrings.py:86
msgid "Location reached"
msgstr "Posizione raggiunta"

#. ui.message() when positional tones are switched on via gesture
#: addon/globalPlugins/objloc/UIStrings.py:89
msgid "Positional tones on"
msgstr "Toni posizionali attivati"

#. ui.message() when positional tones are switched off via gesture
#: addon/globalPlugins/objloc/UIStrings.py:92
msgid "Positional tones off"
msgstr "Toni posizionali disattivati"

#. ui.message() when positional tones for a caret are switched on via gesture
#: addon/globalPlugins/objloc/UIStrings.py:95
msgid "Caret location reporting on"
msgstr "Segnalazione della posizione del cursore di sistema attivata"

#. ui.message() when positional tones for a caret are switched off via gesture
#: addon/globalPlugins/objloc/UIStrings.py:98
msgid "Caret location reporting off"
msgstr "Segnalazione della posizione del cursore di sistema disattivata"

#. Checkbox in settings panel
#: addon/globalPlugins/objloc/UIStrings.py:107
